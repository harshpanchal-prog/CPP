class Solution {
  public:
    vector<vector<int>> transpose(vector<vector<int>>& arr) {
        int r = arr.size() , c = arr[0].size() ;
        for(int i=0 ; i<r ; i++){
            for(int j=0 ; j<i ; j++){
                swap(arr[i][j],arr[j][i]) ;
            }
        }
        return arr ;
    }
};
