class Solution {
public:
    int mySqrt(int x) {
        //M1 :-                    TC=O(sqrt(n))
        // long long n=x ;
        // for(long long i=0 ; i<=x ; i++){
        //     if(i*i==n) return i ;
        //     if(i*i > n) return i-1 ;
        // }
        // return 0 ;

        // M2:- 
        // for(int i=1 ; i<=x ; i++){
        //     if(i==x/i) return i ;
        //     if(i > x/i) return i-1 ;
        // }
        // return 0 ;

        //M3:-                         {Using Binary Search}  TC=O(logn)
        if(x==0) return 0 ;
        int lo=1 , hi=x ;
        while(lo<=hi){
            int mid = lo + (hi-lo)/2 ;
            if(mid > x/mid) hi=mid-1 ;
            else if(mid < x/mid) lo=mid+1 ;
            else return mid ;
        }
        return hi ;
    }
};
