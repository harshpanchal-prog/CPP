class Solution {
public:
    vector<int> searchRange(vector<int>& arr, int tar) {
        int n=arr.size() ;
        vector<int> ans(2,-1) ;
        //First Occurance
        int lo=0 , hi=n-1 ;
        while(lo <= hi){
            int mid = (lo+hi)/2 ;
            if(arr[mid]==tar){
                ans[0]=mid ;
                hi = mid-1 ;
            }
            else if(arr[mid]>tar) hi=mid-1 ;
            else lo=mid+1 ;
        }
        //Last Occurance
        lo=0 , hi=n-1 ;
        while(lo <= hi){
            int mid = (lo+hi)/2 ;
            if(arr[mid]==tar){
                ans[1]=mid ;
                lo = mid+1 ;
            }
            else if(arr[mid]>tar) hi=mid-1 ;
            else lo=mid+1 ;
        }
        return ans ;
    }
};
