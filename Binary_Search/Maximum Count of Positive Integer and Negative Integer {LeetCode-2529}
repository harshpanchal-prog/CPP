class Solution {
public:
    int maximumCount(vector<int>& arr) {
        int n=arr.size() ;
        int pos=0 , neg=0 ;
        int lo=0 , hi=n-1 ;
        while(lo <= hi){
            int mid = (lo+hi)/2 ;
            if(arr[mid]<0){
                lo = mid+1 ;
            }
            else{
                hi = mid-1 ;
            }
        }
        neg=hi+1 ;
        lo=0 , hi=n-1 ;
        while(lo <= hi){
            int mid = (lo+hi)/2 ;
            if(arr[mid]<=0){
                lo = mid+1 ;
            }
            else{
                hi = mid-1 ;
            }
        }
        pos=n-lo ;
        return max(pos,neg) ;
    }
};
