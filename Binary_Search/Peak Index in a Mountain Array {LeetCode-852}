class Solution {
public:
    int peakIndexInMountainArray(vector<int>& arr) {
        int n = arr.size() ;
        // int lo = 0 , hi = n-1 ;    {may give error in mid-1,mid+1 indices}
        int lo = 1 , hi = n-2 ;
        while(lo<=hi){
            int mid = lo + (hi-lo)/2 ;
            if(arr[mid]>arr[mid-1] && arr[mid]>arr[mid+1]) return mid ;
            else if(arr[mid]>arr[mid-1]) lo=mid+1 ;
            else hi=mid-1 ;
        }
        return 1562 ;
    }
};
