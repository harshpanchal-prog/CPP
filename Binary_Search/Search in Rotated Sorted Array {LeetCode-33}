class Solution {
public:
    int search(vector<int>& arr, int tar) {
        int n = arr.size() ;
        int lo=0 , hi=n-1 ;
        while(lo<=hi){                  // Iss question me ye baat to confirm hai ki mid ke koise taraf wala half to sorted hoga hi hoga (ya to left wala ya right wala)
            int mid = lo + (hi-lo)/2 ;
            if(arr[mid]==tar) return mid ;
            if(arr[lo] <= arr[mid]){          // means left half is sorted.
                if(arr[lo]<=tar && tar<=arr[mid]) hi=mid-1 ;
                else lo=mid+1 ;
            }
            else{                            // means right half is sorted.
                if(arr[mid]<=tar && tar<=arr[hi]) lo=mid+1 ;
                else hi=mid-1 ; 
            }
        }
        return -1 ;
    }
};
