class Solution {
public:
    vector<int> findIntersectionValues(vector<int>& a, vector<int>& b) {
        int n=a.size() , m=b.size() ;
        sort(a.begin(),a.end()) ;
        sort(b.begin(),b.end()) ;
        vector<int> ans(2) ;
        int ans1=0,ans2=0 ;
        for(int i=0 ; i<n ; i++){
            for(int j=0 ; j<m ; j++){
                if(b[j]>a[i]) break;      // aisi optimization isliye kar rhe hai bcz we have already sorted both arrays.
                if(a[i]==b[j]) {
                    ans1++ ;
                    break ;
                }
            }
        }
        for(int i=0 ; i<m ; i++){
            for(int j=0 ; j<n ; j++){
                if(a[j]>b[i]) break; 
                
                if(b[i]==a[j]) {
                    ans2++ ;
                    break ;
                }
            }
        }
        ans[0]=ans1 ;
        ans[1]=ans2 ;
        return ans ;
    }
};
