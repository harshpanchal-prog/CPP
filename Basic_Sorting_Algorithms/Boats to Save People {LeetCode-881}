class Solution {
public:
    int numRescueBoats(vector<int>& arr, int limit) {
        sort(arr.begin(),arr.end()) ;
        int boats=0,n=arr.size();
        int i=0 , j=n-1 ;
        // while(i<=j){
        //     if(arr[i]+arr[j] <= limit){
        //         boats++ ;
        //         i++ ;
        //         j-- ;
        //     }
        //     else{
        //         if(min(arr[i],arr[j]) == arr[i]) j-- ;
        //         else i++ ;
        //         boats++ ;
        //     }
        // }

        while(i<=j){
            if(arr[i]+arr[j] <= limit) i++ ;
            j-- ;
            boats++ ;
        }
        return boats ;
    }
};
