class Solution {
public:
    vector<int> twoSum(vector<int>& arr, int target) {
        vector<int> ans(2) ;
        // for(int i=0 ; i<arr.size() ; i++){
        //      for(int j=i+1 ; j<arr.size() ; j++){
        //         if(arr[i] + arr[j] == target){
        //             ans[0]=i+1 ;
        //             ans[1]=j+1 ;
        //         } 
        //      }
        // }

        int n=arr.size() ;
        int i=0,j=n-1 ;
        while(i<j){
            if(arr[i]+arr[j]==target){
                ans[0]=i+1 ;
                ans[1]=j+1 ;
                break ;
            }
            else if(arr[i]+arr[j]>target) j-- ;
            else i++ ;
        }
        return ans ;
    }
};
