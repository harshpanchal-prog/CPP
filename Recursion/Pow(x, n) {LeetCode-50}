class Solution {
public:
    double power(double a, long long b) {
        if(b==0) return 1 ;
        double p = power(a,b/2) ;
        return (b%2==0) ?  (p*p) : (a*p*p) ;
    }
    double myPow(double a, int b) {
        bool flag = (b>=0) ;    //flag is true if b is +ve
        double ans = power(a,abs((long long)b)) ;
        if(flag==false) ans=1/ans ;
        return ans ;
    }
};
