class Solution {
public:
    int binsrch(int lo , int hi , int tar , vector<int>& arr){
        if(lo>hi) return -1 ;
        int mid = (lo+hi)/2 ;
        if(arr[mid]==tar) return mid ;
        else if(arr[mid]>tar) return binsrch(lo,mid-1,tar,arr) ;
        else return binsrch(mid+1,hi,tar,arr) ;
    }
    int search(vector<int>& arr, int tar) {
        int n = arr.size();
        return binsrch(0,n-1,tar,arr) ;
    }
};

