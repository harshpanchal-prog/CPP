class Solution {
  public:
    char nonRepeatingChar(string &s) {
        vector<int> freq(26,0) ;
        int n = s.length() ;
        for(int i=0 ; i<n ; i++){
            int ind = s[i] - 97 ;
            freq[ind]++ ;
        }
        for(int i=0 ; i<n ; i++){
            if(freq[s[i]-97]==1) return s[i] ;
        }
        
        return '$' ;
    }
};
